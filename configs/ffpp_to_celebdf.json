{
  "seed": 42,
  "data": {
    "train_manifest": "data/manifests/ffpp_train_landmarks.jsonl",
    "val_manifest": "data/manifests/ffpp_val_landmarks.jsonl",
    "train_frame_root": "/path/to/ffpp_extracted",
    "train_landmark_root": "/path/to/landmarks",
    "num_frames": 32,
    "texture_frames": 8,
    "image_size": 160,
    "fake_methods": [
      "Deepfakes",
      "Face2Face",
      "FaceSwap",
      "NeuralTextures"
    ],
    "geometry_mode": "aligned_motion_3d",
    "texture_mode": "full_face",
    "sbi": {
      "enabled": false
    },
    "geometry_augmentation": {
      "noise_probability": 0.5,
      "noise_std": 0.01,
      "drift_probability": 0.25,
      "drift_std": 0.002,
      "frame_dropout_probability": 0.25,
      "max_frame_dropout_ratio": 0.15,
      "point_dropout_probability": 0.01
    },
    "texture_augmentation": {
      "flip_probability": 0.5,
      "brightness_contrast_probability": 0.6,
      "gamma_probability": 0.3,
      "gamma_min": 0.75,
      "gamma_max": 1.25,
      "downsample_probability": 0.4,
      "downsample_min_scale": 0.45,
      "blur_probability": 0.3,
      "noise_probability": 0.3,
      "noise_std": 6.0,
      "jpeg_probability": 0.5,
      "jpeg_min_quality": 35,
      "jpeg_max_quality": 90
    },
    "eval_clips_per_video": 3,
    "video_aggregation": "mean",
    "top_k": 1
  },
  "model": {
    "geometry_hidden": 128,
    "geometry_layers": 3,
    "geometry_architecture": "tcn_mean",
    "embedding_dim": 192,
    "dropout": 0.3,
    "texture_pretrained": true,
    "texture_backbone": "efficientnet_b0",
    "fusion_mode": "quality",
    "texture_gate_bias": 0.0,
    "modality_dropout_probability": 0.0
  },
  "training": {
    "epochs": 35,
    "batch_size": 8,
    "num_workers": 4,
    "learning_rate": 0.0003,
    "backbone_learning_rate": 0.00003,
    "weight_decay": 0.0003,
    "geometry_loss_weight": 0.25,
    "texture_loss_weight": 0.25,
    "reliability_gate_loss_weight": 0.0,
    "deterministic": true,
    "balanced_sampler": true,
    "amp": true,
    "early_stop_patience": 5
  },
  "output_dir": "outputs/qalf_ffpp4_effb0_160_8f_full_face"
}
