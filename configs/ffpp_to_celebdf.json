{
  "seed": 42,
  "data": {
    "train_manifest": "data/manifests/ffpp_train_landmarks.jsonl",
    "val_manifest": "data/manifests/ffpp_val_landmarks.jsonl",
    "train_frame_root": "/path/to/ffpp_extracted",
    "train_landmark_root": "/path/to/landmarks",
    "num_frames": 32,
    "texture_frames": 8,
    "image_size": 160,
    "fake_methods": [
      "Deepfakes",
      "Face2Face",
      "FaceSwap",
      "NeuralTextures"
    ],
    "geometry_mode": "aligned_motion_3d",
    "texture_mode": "canonical_skin",
    "geometry_augmentation": {
      "noise_probability": 0.5,
      "noise_std": 0.01,
      "drift_probability": 0.25,
      "drift_std": 0.002,
      "frame_dropout_probability": 0.25,
      "max_frame_dropout_ratio": 0.15,
      "point_dropout_probability": 0.01
    },
    "texture_augmentation": {
      "flip_probability": 0.5,
      "brightness_contrast_probability": 0.6,
      "gamma_probability": 0.3,
      "gamma_min": 0.75,
      "gamma_max": 1.25,
      "downsample_probability": 0.4,
      "downsample_min_scale": 0.45,
      "blur_probability": 0.3,
      "noise_probability": 0.3,
      "noise_std": 6.0,
      "jpeg_probability": 0.5,
      "jpeg_min_quality": 35,
      "jpeg_max_quality": 90
    },
    "self_blend_augmentation": {
      "probability": 0.5,
      "rotation_degrees": 5.0,
      "scale_min": 0.95,
      "scale_max": 1.05,
      "translation_ratio": 0.03,
      "color_gain_min": 0.85,
      "color_gain_max": 1.15,
      "color_bias": 12.0,
      "mask_erode_min_ratio": 0.04,
      "mask_erode_max_ratio": 0.1,
      "mask_blur_ratio": 0.03,
      "opacity_min": 0.7
    },
    "eval_clips_per_video": 3,
    "video_aggregation": "mean",
    "top_k": 1
  },
  "model": {
    "geometry_hidden": 128,
    "geometry_layers": 3,
    "embedding_dim": 192,
    "dropout": 0.3,
    "texture_pretrained": true,
    "texture_backbone": "efficientnet_b0",
    "fusion_mode": "quality"
  },
  "training": {
    "epochs": 35,
    "batch_size": 8,
    "num_workers": 4,
    "learning_rate": 0.0003,
    "backbone_learning_rate": 0.00003,
    "weight_decay": 0.0003,
    "geometry_loss_weight": 0.25,
    "texture_loss_weight": 0.25,
    "self_blend_loss_weight": 0.25,
    "method_adversarial_weight": 0.1,
    "method_grl_strength": 1.0,
    "balanced_sampler": true,
    "amp": true,
    "early_stop_patience": 8
  },
  "output_dir": "outputs/qalf_ffpp4_effb0_dg_160_8f"
}
